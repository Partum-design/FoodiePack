# The Vercel deployment serves the web and API from the same origin.
VITE_API_URL=/api

# API server
PORT=8787
WEB_ORIGIN=http://localhost:5173
ADMIN_PASSWORD=replace-with-a-long-password
JWT_SECRET=replace-with-at-least-32-random-characters

# Zona de entrega. Coordenadas de la cocina y radio de envío gratis en kilómetros.
# Cámbialas por la ubicación exacta de la cocina: de ahí se mide la regla de los 3 km.
KITCHEN_LATITUDE=19.4939
KITCHEN_LONGITUDE=-99.1095
FREE_DELIVERY_RADIUS_KM=3
# Identificación ante Nominatim (OpenStreetMap), que resuelve las direcciones escritas.
GEOCODER_USER_AGENT=FoodiePack/1.0 (pedidos Lindavista CDMX)

# Supabase server-side access. Never expose the service role key to the browser.
SUPABASE_URL=https://icyjsedrzwruihrveyay.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
